# Safe local placeholders for my-agents-frontend.
# Do not put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_NAME=my-agents
MY_AGENTS_BACKEND_URL=http://127.0.0.1:8000
MY_AGENTS_FRONTEND_ORIGIN=http://localhost:3000
MY_AGENTS_SESSION_COOKIE_NAME=my_agents_session
MY_AGENTS_CSRF_COOKIE_NAME=my_agents_csrf
MY_AGENTS_CSRF_HEADER_NAME=X-CSRF-Token
MY_AGENTS_COOKIE_SECURE=false
